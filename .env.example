SPRING_PROFILES_ACTIVE=local
APP_PORT=8080
LOCAL_DEV_AUTH_ENABLED=true
KOREADY_STAGING_OPERATOR_ENABLED=false
KOREADY_STAGING_OPERATOR_TOKEN=replace-with-a-long-random-staging-operator-token
CORS_ALLOWED_ORIGINS=*
GOOGLE_OAUTH_CLIENT_IDS=replace-with-google-web-oauth-client-id
GOOGLE_OAUTH_ISSUER=https://accounts.google.com
GOOGLE_OAUTH_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=https://api.koready.cloud
JWT_AUDIENCE=koready-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

DB_PORT=3306
DB_HOST=localhost
DB_DATABASE=koready
DB_USERNAME=koready
DB_PASSWORD=replace-with-local-mysql-password
DB_ROOT_PASSWORD=replace-with-local-mysql-root-password
DB_URL=jdbc:mysql://localhost:3306/koready?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_POOL_SIZE=5
DB_MIN_IDLE=1
DB_SSL_MODE=require

KTO_SERVICE_KEY=replace-with-local-data-go-kr-service-key
KTO_ENG_API_BASE_URL=https://apis.data.go.kr/B551011/EngService2
KTO_MAX_RESPONSE_BYTES=4194304
KTO_CONNECT_TIMEOUT=3s
KTO_READ_TIMEOUT=10s
KTO_BATCH_PAGE_SIZE=200
KTO_BATCH_FLUSH_SIZE=50
KTO_BATCH_MAX_CONCURRENCY=1
KTO_MANUAL_BATCH_WORKER_ENABLED=true
KTO_MANUAL_BATCH_WORKER_POLL_DELAY=30s
KTO_DETAIL_DAILY_SCHEDULE_ENABLED=false
KTO_DETAIL_DAILY_SCHEDULE_CRON=0 */30 * * * *
KTO_DETAIL_DAILY_SCHEDULE_ZONE=Asia/Seoul
KTO_DETAIL_DAILY_PLACES=800
KTO_DETAIL_DAILY_CHUNK_PLACES=50
KTO_RELATED_TOUR_RESUME_SCHEDULE_ENABLED=false
KTO_RELATED_TOUR_RESUME_SCHEDULE_CRON=0 15 0 * * *
KTO_RELATED_TOUR_RESUME_SCHEDULE_ZONE=Asia/Seoul
KTO_SNAPSHOT_STORAGE=local
KTO_SNAPSHOT_DIRECTORY=replace-with-an-absolute-local-snapshot-directory
KTO_SNAPSHOT_S3_BUCKET=replace-with-private-s3-bucket-name
KTO_SNAPSHOT_S3_CONNECT_TIMEOUT=3s
KTO_SNAPSHOT_S3_READ_TIMEOUT=10s
KTO_SNAPSHOT_DOWNLOAD_EXPIRATION=5m
PROFILE_IMAGE_STORAGE=disabled
PROFILE_IMAGE_S3_BUCKET=replace-with-private-profile-image-bucket-name
PROFILE_IMAGE_UPLOAD_EXPIRATION=10m
PROFILE_IMAGE_VIEW_EXPIRATION=5m
EVIDENCE_BUNDLE_DIRECTORY=replace-with-an-absolute-local-evidence-directory
EVIDENCE_BUNDLE_DOWNLOAD_EXPIRATION=5m
EVIDENCE_BUNDLE_WORKER_POLL_DELAY=30s

# AI editorial worker (disabled until an OpenAI key is configured in the server secret store)
EDITORIAL_WORKER_ENABLED=false
SPRING_AI_MODEL_CHAT=none
OPENAI_API_KEY=replace-with-openai-api-key
EDITORIAL_AI_MODEL=gpt-4o-mini
EDITORIAL_PROMPT_VERSION=koready-place-editorial-v1
EDITORIAL_WORKER_POLL_DELAY=30s
EDITORIAL_WORKER_LEASE_DURATION=5m
EDITORIAL_WORKER_RETRY_DELAY=10m
EDITORIAL_WORKER_MAX_ATTEMPTS=2
EDITORIAL_WORKER_DAILY_LIMIT=100
EDITORIAL_PUBLICATION_FILTER_ENABLED=false

# Kakao location search (staging/prod only; local uses deterministic fixtures)
LOCATION_SEARCH_PROVIDER=disabled
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_LOCAL_MAX_RESPONSE_BYTES=524288
KAKAO_LOCAL_CONNECT_TIMEOUT=3s
KAKAO_LOCAL_READ_TIMEOUT=5s
LOCATION_SEARCH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
LOCATION_SEARCH_TOKEN_TTL=10m
AWS_REGION=ap-northeast-2
KAKAO_REST_API_KEY=replace-with-local-kakao-rest-api-key
TMAP_APP_KEY=replace-with-local-tmap-app-key
